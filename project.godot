; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Shelf Control"
config/description="A 3D virtual library: rooms, shelves and your books."
run/main_scene="res://scenes/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Styles="*res://scripts/styles.gd"
Settings="*res://scripts/settings.gd"
Library="*res://scripts/library.gd"
BookAPI="*res://scripts/book_api.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=2160
window/size/window_width_override=486
window/size/window_height_override=972
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/android/enable_pan_and_scale_gestures=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size.mobile=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=2
lights_and_shadows/directional_shadow/16_bits=false
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile=3
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/positional_shadow/atlas_size.mobile=4096
